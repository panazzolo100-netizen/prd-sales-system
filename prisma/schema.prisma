generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["crm"]
}

enum UserRole {
  EXECUTIVO
  GESTOR
  OPERADOR
  CLIENTE

  @@schema("crm")
}

enum LeadStatus {
  NOVO
  CONTATO
  VISITA
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO

  @@schema("crm")
}

enum ServiceOrderPhotoCategory {
  ANTES
  DURANTE
  DEPOIS

  @@schema("crm")
}

enum ProjectDocumentType {
  CONTRATO

  ART
  TRT

  PROJETO
  PROJETO_AUTOCAD
  PROJETO_DXF
  PROJETO_EXECUTIVO
  PROJETO_APROVADO
  AS_BUILT

  // NOVOS
  PROJECT_UNIFILAR
  PROJECT_TRIFILAR
  PLANTA_BAIXA
  CARTA_APROVACAO
  OUTROS_TECNICOS

  MEMORIAL
  LISTA_MATERIAIS
  DIAGRAMA

  NOTA_FISCAL

  FOTOS
  DRONE

  GARANTIA
  MANUAL

  OUTRO

  @@schema("crm")
}

model Company {
  id String @id @default(cuid())

  serviceOrders ServiceOrder[]

  cashFlow CashFlow[]

  name String

  tradeName String?

  address String?

  logoUrl String?

  document String?

  phone String?

  financials Financial[]

  email String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  leads Lead[]

  clients Client[]

  projects Project[]

  agendaEvents AgendaEvent[]

  @@schema("crm")
}

model User {
  id String @id @default(cuid())

  name String

  jobTitle String?

  displayName String?

  homePage String @default("/")

  interfaceDensity String @default("COMFORTABLE")

  email String @unique

  password String?

  role UserRole @default(OPERADOR)

  forcePasswordChange Boolean @default(true)

  temporaryPassword Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  clientId String?

  client Client? @relation(fields: [clientId], references: [id])

  leads Lead[]

  activities Activity[]

  projectDocuments ProjectDocument[]

  uploadedLeadFiles LeadFile[]

  responsibleAgendaEvents AgendaEvent[] @relation("AgendaResponsible")
  createdAgendaEvents     AgendaEvent[] @relation("AgendaCreatedBy")

  @@index([companyId, clientId])
  @@schema("crm")
}

model Lead {
  id String @id @default(cuid())

  companyName String

  contactName String

  phone String?

  email String?

  city String?

  state String?

  source String?

  serviceType    String?
  serviceDetails Json?

  status LeadStatus @default(NOVO)

  distributor String?

  consumerUnit String?

  consumptionKwh Float?

  demandKw Float?

  estimatedValue Float?

  expectedSaving Float?

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  archivedAt DateTime?

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  ownerId String?

  owner User? @relation(fields: [ownerId], references: [id])

  client Client?

  activities Activity[]

  files LeadFile[]

  projectDocuments ProjectDocument[]

  engineering LeadEngineering?

  dimensioning LeadDimensioning?

  proposal Proposal?

  agendaEvents AgendaEvent[]

  @@schema("crm")
}

model LeadFile {
  id String @id @default(cuid())

  name String

  url String

  mimeType String

  size Int

  observation String? @db.VarChar(160)

  createdAt DateTime @default(now())

  leadId String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  uploadedById String?

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@schema("crm")
}

model LeadEngineering {
  id String @id @default(cuid())

  systemType String?

  installedPower Float?

  modules Int?

  modulePower Float?

  moduleBrand String?

  inverter String?

  distributor String?

  consumerUnit String?

  tariffGroup String?

  consumerClass String?

  contractedDemand Float?

  measuredDemand Float?

  roofType String?

  roofArea Float?

  roofOrientation String?

  roofSlope Float?

  shading String?

  structureType String?

  voltage String?

  phase String?

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  leadId String @unique

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@schema("crm")
}

model LeadDimensioning {
  id String @id @default(cuid())

  monthlyConsumption Float?

  solarIrradiation Float?

  lossFactor Float?

  modulePower Float?

  moduleQuantity Int?

  installedPower Float?

  estimatedGeneration Float?

  systemValue Float?

  energyTariff Float?

  monthlySaving Float?

  annualSaving Float?

  paybackYears Float?

  requiredArea Float?

  estimatedSaving Float?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  leadId String @unique

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@schema("crm")
}

model Client {
  id String @id @default(cuid())

  name String

  document String?

  phone String?

  email String?

  city String?

  state String?

  address String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  leadId String? @unique

  lead Lead? @relation(fields: [leadId], references: [id])

  proposals Proposal[]

  projects Project[]

  users User[]

  agendaEvents AgendaEvent[]

  @@schema("crm")
}

model Proposal {
  id String @id @default(cuid())

  title  String
  amount Float

  systemPower Float?

  monthlySaving Float?
  annualSaving  Float?

  payback Float?

  status String @default("RASCUNHO")

  validUntil DateTime?

  paymentTerms      String?
  executionDeadline String?
  commercialNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  @@schema("crm")
}

model Project {
  id String @id @default(cuid())

  serviceOrder ServiceOrder?

  documents ProjectDocument[]

  timeline ProjectTimeline[]

  title String

  serviceType String @default("USINA_SOLAR")

  stages ProjectStage[]

  status String @default("NOVO")

  description String?

  financial Financial?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  agendaEvents AgendaEvent[]

  technicalSpecification ProjectTechnicalSpecification?
  engineeringEquipments  EngineeringEquipment[]
  engineeringMaterials   EngineeringMaterial[]
  engineeringCoordinates EngineeringCoordinate[]
  engineeringStrings     EngineeringString[]

  @@schema("crm")
}

model ProjectTechnicalSpecification {
  id String @id @default(cuid())

  systemType       String?
  installedPower   Float?
  connectionPower  Float?
  generationTarget Float?

  distributor       String?
  consumerUnit      String?
  tariffGroup       String?
  consumerClass     String?
  contractedDemand  Float?
  measuredDemand    Float?
  voltage            String?
  phase              String?
  connectionStandard String?

  installationAddress String?
  city                String?
  state               String?

  roofType        String?
  roofArea        Float?
  roofOrientation String?
  roofSlope       Float?
  shading         String?
  structureType   String?

  technicalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@schema("crm")
}

model EngineeringEquipment {
  id String @id @default(cuid())

  type         String
  manufacturer String?
  model        String?
  description  String?

  quantity Int   @default(1)
  power    Float?
  unit     String?

  voltage     Float?
  current     Float?
  mppt        Int?
  efficiency  Float?
  dimensions  String?
  weight      Float?

  technicalData Json?
  notes         String?
  position      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, type])
  @@index([projectId, position])
  @@schema("crm")
}

model EngineeringMaterial {
  id String @id @default(cuid())

  category     String
  description  String
  manufacturer String?
  model        String?

  quantity Float
  unit     String

  specification String?
  notes         String?
  position      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, category])
  @@index([projectId, position])
  @@schema("crm")
}

model EngineeringCoordinate {
  id String @id @default(cuid())

  type        String
  name        String
  latitude    Float
  longitude   Float
  description String?

  elevation Float?
  reference String?
  position  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, type])
  @@index([projectId, position])
  @@schema("crm")
}

model EngineeringString {
  id String @id @default(cuid())

  name           String
  mppt           String?
  moduleQuantity Int
  orientation    String?
  tilt           Float?
  azimuth        Float?
  notes          String?
  position       Int @default(0)

  equipmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, position])
  @@index([equipmentId])
  @@schema("crm")
}

model ProjectStage {
  id          String    @id @default(cuid())
  title       String
  position    Int
  completed   Boolean   @default(false)
  dueDate     DateTime?
  responsible String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
  @@index([projectId, completed])
  @@schema("crm")
}

model ProjectTimeline {
  id String @id @default(cuid())

  type String

  title String

  description String?

  createdAt DateTime @default(now())

  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, createdAt])
  @@schema("crm")
}

model Activity {
  id String @id @default(cuid())

  type String

  title String

  notes String?

  dueDate DateTime?

  done Boolean @default(false)

  createdAt DateTime @default(now())

  leadId String

  lead Lead @relation(fields: [leadId], references: [id])

  userId String?

  user User? @relation(fields: [userId], references: [id])

  @@schema("crm")
}

model Financial {
  id String @id @default(cuid())

  saleValue     Float @default(0)
  costValue     Float @default(0)
  receivedValue Float @default(0)

  cashFlow CashFlow[]

  installments FinancialInstallment[]

  attachments FinancialAttachment[]

  status String @default("PENDENTE")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])

  @@schema("crm")
}

model ServiceOrder {
  id String @id @default(cuid())

  number String @unique
  title  String
  status String @default("ABERTA")

  responsible  String?
  team         String?
  priority     String  @default("NORMAL")
  scheduleType String  @default("COMPROMISSO")

  scheduledDate DateTime?
  startedDate   DateTime?
  completedDate DateTime?

  services  String?
  materials String?
  notes     String?

  checklistArt                Boolean @default(false)
  checklistProjectApproved    Boolean @default(false)
  checklistMaterialsSeparated Boolean @default(false)
  checklistStructureInstalled Boolean @default(false)
  checklistModulesInstalled   Boolean @default(false)
  checklistInverterInstalled  Boolean @default(false)
  checklistDcCabling          Boolean @default(false)
  checklistAcCabling          Boolean @default(false)
  checklistCommissioning      Boolean @default(false)
  checklistCustomerTraining   Boolean @default(false)
  checklistDelivered          Boolean @default(false)

  customerName      String?
  customerDocument  String?
  customerSignature String?

  technicianName      String?
  technicianSignature String?

  signedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])

  photos ServiceOrderPhoto[]

  timeline ServiceOrderTimeline[]

  agendaEvents AgendaEvent[]

  @@schema("crm")
}


model AgendaEvent {
  id String @id @default(cuid())

  title       String
  type        String @default("OUTRO")
  status      String @default("AGENDADO")
  color       String @default("ORANGE")
  allDay      Boolean @default(false)
  startAt     DateTime
  endAt       DateTime?

  location    String?
  description String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  responsibleId String?
  responsible   User? @relation("AgendaResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User @relation("AgendaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, startAt])
  @@index([companyId, responsibleId, startAt])
  @@index([clientId])
  @@index([leadId])
  @@index([projectId])
  @@index([serviceOrderId])
  @@schema("crm")
}

model ServiceOrderSequence {
  id String @id @default(cuid())

  companyId  String @unique
  lastNumber Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("crm")
}

model ServiceOrderPhoto {
  id String @id @default(cuid())

  name     String
  url      String
  mimeType String
  size     Int

  category ServiceOrderPhotoCategory

  notes String?

  createdAt DateTime @default(now())

  serviceOrderId String

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([serviceOrderId, category])
  @@schema("crm")
}

model ServiceOrderTimeline {
  id String @id @default(cuid())

  type        String
  title       String
  description String?

  createdAt DateTime @default(now())

  serviceOrderId String

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@schema("crm")
}

model ProjectDocument {
  id String @id @default(cuid())

  name     String
  url      String
  mimeType String
  size     Int

  type ProjectDocumentType

  notes String?

  isFavorite Boolean @default(false)

  uploadedById String?

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String?

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectId String?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([leadId, type])
  @@index([projectId])
  @@index([projectId, type])
  @@index([uploadedById])
  @@schema("crm")
}

model CashFlow {
  id String @id @default(cuid())

  description String

  type String

  category String?

  value Float

  dueDate DateTime?

  paidAt DateTime?

  status String @default("PENDENTE")

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  financialId String?

  financial Financial? @relation(fields: [financialId], references: [id])

  @@index([companyId])
  @@index([status])
  @@schema("crm")
}

model FinancialInstallment {
  id String @id @default(cuid())

  number Int

  description String?

  value Float

  dueDate DateTime

  paidAt DateTime?

  status String @default("PENDENTE")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialId String

  financial Financial @relation(fields: [financialId], references: [id], onDelete: Cascade)

  @@unique([financialId, number])
  @@index([financialId])
  @@index([dueDate])
  @@index([status])
  @@schema("crm")
}

model FinancialAttachment {
  id String @id @default(cuid())

  name     String
  url      String
  mimeType String
  size     Int

  type String @default("COMPROVANTE")

  createdAt DateTime @default(now())

  financialId String

  financial Financial @relation(fields: [financialId], references: [id], onDelete: Cascade)

  @@index([financialId])
  @@schema("crm")
}